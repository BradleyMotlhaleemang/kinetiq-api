generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum TrainingGoal {
  HYPERTROPHY
  STRENGTH
  POWERBUILDING
  POWERLIFTING
}

enum SplitStyle {
  PPL
  UPPER_LOWER
  FULL_BODY
  BODY_PART
  HYBRID
  SPECIALIZED
  SPECIALIZATION
  LOWER_BIAS
}

enum WorkoutStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum DayType {
  WORKOUT
  REST
}

enum SessionType {
  MESOCYCLE
  SPLIT
  STANDALONE
}

enum ExerciseCategory {
  PRIMARY_COMPOUND
  COMPOUND_ACCESSORY
  ISOLATION_PRIMARY
  ISOLATION_AUXILIARY
}

enum MuscleGroup {
  CHEST
  BACK
  LATS
  FRONT_DELT
  SIDE_DELT
  REAR_DELT
  QUADS
  HAMSTRINGS
  GLUTES
  BICEPS
  TRICEPS
  CALVES
  LOWER_BACK
}

enum MovementPattern {
  HORIZONTAL_PUSH
  VERTICAL_PUSH
  HORIZONTAL_PULL
  VERTICAL_PULL
  SQUAT
  HINGE
  ISOLATION
}

enum ExerciseType {
  COMPOUND
  ISOLATION
}

enum MovementClass {
  BACK_STRAIGHT_ARM_PULL
  BACK_VERTICAL_PULL
  BACK_HORIZONTAL_PULL
  BACK_AXIAL_HINGE
  GLUTE_HIP_THRUST
  GLUTE_HIP_HINGE
  GLUTE_SQUAT
  GLUTE_HIP_ABDUCTION
  GLUTE_KICKBACK
  CALF_STANDING
  CALF_SEATED
  CALF_UNILATERAL
  CALF_STRETCH_BIASED
  CORE_SPINAL_FLEXION
  CORE_ANTI_EXTENSION
  CORE_ANTI_ROTATION
  CORE_ROTATION
  CORE_HIP_FLEXION
  CORE_LOADED_CARRY
  // Chest
  CHEST_HORIZONTAL_PRESS
  CHEST_INCLINE_PRESS
  CHEST_ADDUCTION_FLY
  CHEST_STRETCH_BIASED

  // Shoulders
  SHOULDER_VERTICAL_PRESS
  SHOULDER_LATERAL_ABDUCTION
  SHOULDER_REAR_DELT
  SHOULDER_LENGTHENED

  // Biceps
  BICEP_SUPINATED_CURL
  BICEP_LENGTHENED
  BICEP_SHORTENED
  BICEP_NEUTRAL_BRACHIALIS

  // Triceps
  TRICEP_PRESS_COMPOUND
  TRICEP_PUSHDOWN
  TRICEP_OVERHEAD_EXTENSION
  TRICEP_LENGTHENED

  // Quads
  QUAD_BILATERAL_SQUAT
  QUAD_MACHINE_PRESS
  QUAD_UNILATERAL
  QUAD_KNEE_EXTENSION

  // Hamstrings
  HAMSTRING_HIP_HINGE
  HAMSTRING_KNEE_FLEXION
  HAMSTRING_UNILATERAL
  HAMSTRING_LENGTHENED
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  displayName      String
  experienceLevel  String   @default("INTERMEDIATE")
  trainingAgeMths  Int      @default(0)
  bodyweightKg     Float?
  refreshTokenHash String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  gender                String?
  dateOfBirth           DateTime?
  goalMode              String?
  onboardingCompletedAt DateTime?
  notificationsEnabled  Boolean   @default(true)
  preferredTrainingTime String?
  classificationScore       Int?
  recommendedLevel          String?
  levelOverrideAcknowledged Boolean   @default(false)
  classificationConfidence  Float?
  classificationCompletedAt DateTime?
  mesocycles            Mesocycle[]
  workouts              Workout[]
  sessionReadiness   SessionReadiness[]
  weeklyFeedback     WeeklyFeedback[]
  performanceHistory PerformanceHistory[]
  progressionLogs    ProgressionLog[]
  prRecords          PRRecord[]
  plateauMarkers     PlateauMarker[]
  bioFeedback          BioFeedback[]
  exerciseSubstitutions ExerciseSubstitution[]
  bodyMetricLogs       BodyMetricLog[]
  notifications        NotificationLog[]
  fatigueSnapshots   FatigueSnapshot[]
  cardioSessions   CardioSession[]
  foodLogs         FoodLog[]
  nutritionTarget  NutritionTarget?
  supplementLogs   SupplementLog[]
  exerciseSFRs     UserExerciseSFR[]
  restPreferences  RestPreference[]
  setRestLogs      SetRestLog[]
  passwordResetToken       String?
  passwordResetTokenExpiry DateTime?
  emailVerified              Boolean   @default(false)
  emailVerificationToken     String?
  emailVerificationTokenExpiry DateTime?
  failedLoginAttempts        Int       @default(0)
  lockedUntil                DateTime?
  muscleGroupFeedback MuscleGroupFeedback[]
  splitTemplates      SplitTemplate[]
}

model AuthAuditLog {
  id        String   @id @default(cuid())
  userId    String?
  email     String?
  event     String
  reason    String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([event, createdAt])
  @@index([userId, createdAt])
}

model Exercise {
  id               String                     @id @default(cuid())
  name             String                     @unique
  primaryMuscle    MuscleGroup
  secondaryMuscles MuscleGroup[]
  movementPattern  MovementPattern
  exerciseType     ExerciseType
  movementClass    MovementClass?
  category         ExerciseCategory           @default(PRIMARY_COMPOUND)
  isCompound       Boolean                    @default(true)
  metadata         ExerciseMetadata?
  substitutionPools SubstitutionPoolExercise[]
  sets              Set[]
  performanceHistory PerformanceHistory[]
  progressionLogs    ProgressionLog[]
  prRecords          PRRecord[]
  plateauMarkers     PlateauMarker[]
  originalSubstitutions  ExerciseSubstitution[] @relation("OriginalExercise")
  substituteSubstitutions ExerciseSubstitution[] @relation("SubstituteExercise")
  exerciseSFRs     UserExerciseSFR[]
  splitDayExercises SplitDayExercise[]
  workoutExercises  WorkoutExercise[]
}

model ExerciseMetadata {
  id                      String           @id @default(cuid())
  exerciseId              String           @unique
  exercise                Exercise         @relation(fields: [exerciseId], references: [id])
  fatigueScore            Float
  stabilityDemand         Float
  methodFatigueMultiplier Float
  equipmentProfileId      String
  equipmentProfile        EquipmentProfile @relation(fields: [equipmentProfileId], references: [id])
  executionProfileId      String
  executionProfile        ExecutionProfile @relation(fields: [executionProfileId], references: [id])
}

model EquipmentProfile {
  id                String             @id @default(cuid())
  name              String             @unique
  requiredEquipment String[]
  exercises         ExerciseMetadata[]
}

model ExecutionProfile {
  id          String             @id @default(cuid())
  zone        String             @unique
  description String
  rpeRange    String
  multiplier  Float
  exercises   ExerciseMetadata[]
}

model SubstitutionPool {
  id              String                     @id @default(cuid())
  name            String                     @unique
  primaryMuscle   String
  movementPattern String
  exercises       SubstitutionPoolExercise[]
}

model SubstitutionPoolExercise {
  id               String           @id @default(cuid())
  poolId           String
  pool             SubstitutionPool @relation(fields: [poolId], references: [id])
  exerciseId       String
  exercise         Exercise         @relation(fields: [exerciseId], references: [id])
  priority         Int
  suitableWhenPain String[]

  @@unique([poolId, exerciseId])
}

model SplitTemplate {
  id              String              @id @default(uuid())
  userId          String?
  user            User?               @relation(fields: [userId], references: [id])
  slug            String?             @unique
  name            String              @unique
  level           ExperienceLevel
  goal            TrainingGoal
  primaryMuscle   String

  isSystem        Boolean             @default(false)
  splitLabel      String
  splitType       String
  daysPerWeek     Int
  description     String?
  goalTags        String[]
  experienceTags  String[]

  days            SplitDay[]
  mesocycleTemplates MesocycleTemplate[]
  mesocycles      Mesocycle[]
  workouts        Workout[]

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([level, goal])
}

model SplitDay {
  id              String             @id @default(cuid())
  splitTemplateId String
  splitTemplate   SplitTemplate      @relation(fields: [splitTemplateId], references: [id])
  dayNumber       Int
  dayType         DayType
  label           String
  exercises       SplitDayExercise[]
  workouts        Workout[]

  @@unique([splitTemplateId, dayNumber])
}

model SplitDayExercise {
  id          String   @id @default(cuid())
  splitDayId  String
  splitDay    SplitDay @relation(fields: [splitDayId], references: [id])
  exerciseId  String
  exercise    Exercise @relation(fields: [exerciseId], references: [id])
  orderIndex  Int
  setsTarget  Int
  repRangeMin Int
  repRangeMax Int
}

model Mesocycle {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id])
  name           String
  status         String     @default("ACTIVE")
  startDate      DateTime   @default(now())
  currentWeek    Int        @default(1)
  totalWeeks     Int        @default(8)
  volumeTargets  Json
  mesocycleTemplateId String?
  mesocycleTemplate   MesocycleTemplate? @relation("TemplateSource", fields: [mesocycleTemplateId], references: [id])
  splitTemplateId     String
  splitTemplate       SplitTemplate @relation(fields: [splitTemplateId], references: [id])
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  workouts       Workout[]
  weeklyFeedback     WeeklyFeedback[]
}

model MesocycleTemplate {
  id                String              @id @default(uuid())
  slug              String              @unique
  name              String
  level             ExperienceLevel
  goal              TrainingGoal
  splitTemplateId   String
  splitTemplate     SplitTemplate       @relation(fields: [splitTemplateId], references: [id])
  durationWeeksMin  Int
  durationWeeksMax  Int
  progressionType   String
  progressionNotes  String?
  deloadWeek        Int?
  deloadNotes       String?
  difficultyWarning String?
  featured          Boolean             @default(false)
  mesocycles        Mesocycle[]         @relation("TemplateSource")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([level, goal])
}

model Workout {
  id                 String           @id @default(cuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id])
  mesocycleId        String?
  mesocycle          Mesocycle?       @relation(fields: [mesocycleId], references: [id])
  splitTemplateId    String?
  splitTemplate      SplitTemplate?   @relation(fields: [splitTemplateId], references: [id])
  splitDayId         String?
  splitDay           SplitDay?        @relation(fields: [splitDayId], references: [id])
  weekNumber         Int?
  dayNumber          Int?
  sessionType        SessionType
  date               DateTime?
  splitDayLabel      String?
  status             WorkoutStatus    @default(PLANNED)
  startedAt          DateTime?
  completedAt        DateTime?
  scheduledDate      DateTime?
  prescriptionSnapshot Json?
  notes              String?
  totalVolume        Float?
  totalSets          Int?
  durationMinutes    Int?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  sets               Set[]
  sessionReadiness   SessionReadiness?
  performanceHistory PerformanceHistory[]
  prRecords          PRRecord[]
  bioFeedback          BioFeedback?
  setRestLogs      SetRestLog[]
  workoutExercises  WorkoutExercise[]
}

model WorkoutExercise {
  id               String   @id @default(cuid())
  workoutId        String
  workout          Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId       String
  exercise         Exercise @relation(fields: [exerciseId], references: [id])
  orderIndex       Int
  setsTarget       Int
  repRangeMin      Int
  repRangeMax      Int
  sourceExerciseId String?
  createdAt        DateTime @default(now())

  @@unique([workoutId, exerciseId])
  @@index([workoutId])
}

model Set {
  id               String   @id @default(cuid())
  workoutId        String
  workout          Workout  @relation(fields: [workoutId], references: [id])
  exerciseId       String
  exercise         Exercise @relation(fields: [exerciseId], references: [id])
  setNumber        Int
  weight           Float
  reps             Int
  rpe              Float?
  e1rm             Float?
  effectiveReps    Float?
  fatigueCost      Float?
  stimulusScore    Float?
  isPR             Boolean  @default(false)
  prType           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([workoutId, exerciseId, setNumber])
}

model SessionReadiness {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id])
  workoutId           String?  @unique
  workout             Workout? @relation(fields: [workoutId], references: [id])
  sleepScore          Int
  stressScore         Int
  nutritionScore      Int
  motivationScore     Int
  muscleReadinessScore Int
  sessionReadiness    Float
  sessionMode         String
  createdAt           DateTime @default(now())
}

model WeeklyFeedback {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id])
  mesocycleId        String?
  mesocycle          Mesocycle? @relation(fields: [mesocycleId], references: [id])
  weekNumber         Int
  motivationScore    Int
  fatiguePerception  Int
  performanceFeeling Int
  energyLevelAvg     Float?
  sleepQualityAvg    Float?
  stressLevelAvg     Float?
  jointPainMap       Json?
  notes              String?
  loggedAt           DateTime  @default(now())

  @@unique([userId, mesocycleId, weekNumber])
}

model KnowledgeEntry {
  id             String   @id @default(cuid())
  slug           String   @unique
  category       String
  title          String
  summary        String
  body           String
  relatedSlugs   Json?
  targetAudience String   @default("ALL")
  tags           Json?
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PerformanceHistory {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  exerciseId  String
  exercise    Exercise @relation(fields: [exerciseId], references: [id])
  workoutId   String
  workout     Workout  @relation(fields: [workoutId], references: [id])
  bestE1rm    Float
  bestWeight  Float
  bestReps    Int
  totalVolume Float
  totalSets   Int
  date        DateTime

  @@unique([userId, exerciseId, date])
}

model ProgressionLog {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  exerciseId      String
  exercise        Exercise @relation(fields: [exerciseId], references: [id])
  action          String
  weightTarget    Float?
  prescribedWeight    Float?
  prescribedReps      Int?
  prescribedSets      Int?
  actualWeight        Float?
  actualReps          Int?
  actualSets          Int?
  completionRate      Float?
  repCompletionRate   Float?
  physiologicalState  String?
  confidenceLevel     String?
  enginePhase         String?
  status              ProgressionLogStatus @default(PENDING)
  workoutId           String?
  reason          String
  contextSnapshot Json?
  loggedAt        DateTime @default(now())

  @@index([workoutId])
}

enum ProgressionLogStatus {
  PENDING
  COMPLETED
  SKIPPED
}

enum PRScope {
  ALL_TIME
  MESOCYCLE
  MONTHLY
}

enum PRType {
  E1RM
  WEIGHT
  VOLUME
}

model PRRecord {
  id            String    @id @default(cuid())
  userId        String
  exerciseId    String
  workoutId     String
  setId         String?
  mesocycleId   String?
  monthYear     String?
  scope         PRScope
  type          PRType
  equipmentName String?
  value         Float
  weight        Float
  reps          Int
  e1rm          Float
  achievedAt    DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id])
  exercise      Exercise  @relation(fields: [exerciseId], references: [id])
  workout       Workout   @relation(fields: [workoutId], references: [id])

  @@index([userId, exerciseId, scope, type])
  @@index([userId, achievedAt])
}

model PlateauMarker {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  reason     String
  createdAt  DateTime @default(now())
  resolved   Boolean  @default(false)
}

model BioFeedback {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  workoutId        String?  @unique
  workout          Workout? @relation(fields: [workoutId], references: [id])
  sorenessLog      Json
  jointComfortLog  Json
  globalJointComfortScore Int
  trainingDrive    Int
  sessionPerformance Int
  pumpScore        Int
  effortScore      Int?
  loggedAt         DateTime @default(now())
  muscleGroupFeedback MuscleGroupFeedback[]
}

model ExerciseSubstitution {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  originalExerciseId String
  originalExercise   Exercise @relation("OriginalExercise", fields: [originalExerciseId], references: [id])
  substituteExerciseId String
  substituteExercise   Exercise @relation("SubstituteExercise", fields: [substituteExerciseId], references: [id])
  jointAffected      String
  painScoreAtSwap    Float
  status             String   @default("ACTIVE")
  phase              Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model BodyMetricLog {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  weightKg      Float
  bodyFatPercent Float?
  trend         String?
  rollingAvg7d  Float?
  loggedAt      DateTime @default(now())
}

model NotificationLog {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  type            String
  deliveryChannel String   @default("IN_APP")
  payload         Json?
  isRead          Boolean  @default(false)
  readAt          DateTime?
  createdAt       DateTime @default(now())

}
model FatigueSnapshot {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  snapshotAt         DateTime @default(now())
  sfl24h             Float
  sfl48h             Float
  sfl72h             Float
  sfl7d              Float
  cnsLoadScore       Float
  metabolicLoadScore Float
  muscleFatigueMap   Json
  jointStressMap     Json
}

model CardioSession {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  type             String
  durationMinutes  Int
  distanceKm       Float?
  avgHeartRate     Int?
  peakHeartRate    Int?
  caloriesEstimated Float?
  cardioZone       String
  perceivedEffort  Int
  sflContribution  Float
  loggedAt         DateTime @default(now())
}

model FoodItem {
  id              String     @id @default(cuid())
  name            String     @unique
  caloriesPer100g Float
  proteinPer100g  Float
  carbsPer100g    Float
  fatPer100g      Float
  category        String
  isVerified      Boolean    @default(false)
  foodLogs        FoodLog[]
  supplementLogs  SupplementLog[]
}

model FoodLog {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  date              DateTime
  mealType          String
  foodItemId        String
  foodItem          FoodItem @relation(fields: [foodItemId], references: [id])
  quantityGrams     Float
  caloriesConsumed  Float
  proteinConsumed   Float
  carbsConsumed     Float
  fatsConsumed      Float
  loggedAt          DateTime @default(now())
}

model NutritionTarget {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id])
  caloriesTarget         Float
  proteinTarget          Float
  carbsTarget            Float
  fatsTarget             Float
  calculatedFromWeightKg Float
  lastCalculatedAt       DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model SupplementLog {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  foodItemId     String
  foodItem       FoodItem @relation(fields: [foodItemId], references: [id])
  supplementName String
  doseMg         Float
  takenAt        DateTime @default(now())
}

model UserExerciseSFR {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  exerciseId  String
  exercise    Exercise @relation(fields: [exerciseId], references: [id])
  sfrScore    Float
  stimulusAvg Float
  fatigueAvg  Float
  sampleSize  Int
  updatedAt   DateTime @updatedAt

  @@unique([userId, exerciseId])
}

model RestPreference {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  exerciseId  String?
  sessionType String?
  restSeconds Int

  @@unique([userId, exerciseId])
}

model SetRestLog {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  workoutId       String
  workout         Workout  @relation(fields: [workoutId], references: [id])
  setId           String
  previousSetId   String?
  actualRestSeconds Int
  loggedAt        DateTime @default(now())
}

model MuscleGroupFeedback {
  id            String      @id @default(cuid())
  bioFeedbackId String
  bioFeedback   BioFeedback @relation(fields: [bioFeedbackId], references: [id])
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  workoutId     String
  muscleGroup   String

  jointComfort      String
  jointComfortScore Int

  soreness       String
  sorenessScore  Float

  volume         String
  volumeSignal   Float

  loggedAt       DateTime @default(now())

  @@unique([bioFeedbackId, muscleGroup])
}
