# Runtime
NODE_ENV=development
PORT=3000

# Database (Docker Compose: host=postgres)
DATABASE_URL=postgresql://kinetiq:changeme@localhost:5432/kinetiq

# Redis (Docker Compose: host=redis; omit locally to default localhost)
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth
JWT_SECRET=change-me-min-64-chars-use-openssl-rand-base64-48
JWT_REFRESH_SECRET=change-me-min-64-chars-use-openssl-rand-base64-48

# CORS — production: browser requests allowed only from these origins
FRONTEND_URL=https://app.yourdomain.com
# Optional extra origins (comma-separated)
# CORS_ORIGINS=https://app.yourdomain.com

# Email (Gmail app password or transactional provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Cron timezone for MesocycleAdvanceWorker (container TZ)
TZ=Africa/Gaborone

# Rate limiting (optional overrides)
# THROTTLE_TTL_MS=60000
# THROTTLE_LIMIT=100

# Sentry (optional locally)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=

# Seed — set true in production to load catalog only (no dev@kinetiq.local)
# SEED_SKIP_DEV_USERS=true
# DEV_SEED_PASSWORD=DevPass123!
