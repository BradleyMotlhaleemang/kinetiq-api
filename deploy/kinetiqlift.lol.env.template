# Kinetiq production — kinetiqlift.lol
# Copy values into Coolify environment variables (or deploy/.env on server).
# NEVER commit a file with real secrets.

DOMAIN=kinetiqlift.lol

# Generate with: scripts/generate-production-secrets.ps1
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_REFRESH_SECRET=

# GHCR (two-repo setup — images built by GitHub Actions on push to main)
KINETIQ_API_IMAGE=ghcr.io/bradleymotlhaleemang/kinetiq-api:latest
KINETIQ_APP_IMAGE=ghcr.io/bradleymotlhaleemang/kinetiq-app:latest

# Email (Gmail app password recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional
TZ=Africa/Gaborone
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=

# Coolify domain mapping (set in Coolify UI, not env):
#   app service → https://app.kinetiqlift.lol
#   api service → https://api.kinetiqlift.lol

# API container receives (from compose):
#   FRONTEND_URL=https://app.kinetiqlift.lol
#   CORS_ORIGINS=https://app.kinetiqlift.lol

# App image must be built with (set GitHub repo variable on kinetiq-app):
#   KINETIQ_DOMAIN=kinetiqlift.lol
#   → NEXT_PUBLIC_API_URL=https://api.kinetiqlift.lol
